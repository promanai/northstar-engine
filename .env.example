# AI provider keys are configured in the client's Cloudflare environment.
# New builds default to Lite. Existing Worker deployments with DB keep Standard
# unless ENGINE_MODE is explicitly set. Do not copy this file over old secrets.
ENGINE_MODE=lite
# Global emergency stop for NEW paid requests in both modes. No effect on active calls.
# AI_PAID_REQUESTS_ENABLED=true
# Standard only: durable site-wide quotas, not billing limits. UTC calendar periods.
# AI_DAILY_REQUEST_LIMIT=100
# AI_MONTHLY_REQUEST_LIMIT=1000
# AI_MAX_INPUT_BYTES=131072
# AI_MAX_OUTPUT_TOKENS=4096
LITE_AI_ENABLED=false
# Optional stateless lead delivery. Off until a receiver and its contract are configured.
LITE_LEADS_ENABLED=false
LITE_LEAD_RECIPIENT=
LITE_LEAD_PRIVACY_PATH=/privacy
# Configure both as Worker secrets. HTTPS receiver must deduplicate Idempotency-Key.
LITE_LEAD_WEBHOOK_URL=
LITE_LEAD_WEBHOOK_TOKEN=
# Voice is separately opt-in and uses OpenAI, even with an xAI text consultant.
LITE_VOICE_ENABLED=false
LITE_VOICE_MODEL=gpt-realtime-mini
LITE_VOICE_VOICE=marin
LITE_AI_PROVIDER=openai
LITE_AI_MODEL=gpt-4o-mini
LITE_AI_REASONING=auto
LITE_AI_MAX_TOKENS=1024
# LITE_SYSTEM_PROMPT is a server-side business instruction, never a place for secrets.
LITE_SYSTEM_PROMPT=
# Optional installation preset; leave empty for the generic engine.
LITE_SITE_PRESET=
# Shared preset selector for Lite and Standard; takes precedence over LITE_SITE_PRESET.
SITE_PRESET=
# OraVera: keep false until clinical, privacy, vendor and retention review.
# This owner acknowledgement is NOT proof of compliance or a vendor BAA.
LITE_HEALTH_DATA_ENABLED=false
OPENAI_API_KEY=
XAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# AI_GATEWAY_ID=
# Required only for the first owner registration; use a random value of 32+ characters.
# Set with wrangler secret put INITIAL_ADMIN_TOKEN on Cloudflare.
INITIAL_ADMIN_TOKEN=
# Optional release updater. Set production values in Worker environment/secrets.
UPDATE_RUNNER_REPOSITORY=
UPDATE_RUNNER_SECRET=
GITHUB_RELEASE_TOKEN=
# Payment: use PAYMENT_PROVIDER=stripe for the built-in Stripe Checkout adapter.
PAYMENT_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_SITE_URL=https://example.com
# Standard booking notifications. Keep off until the clinic approves this destination.
# Store the bot token and numeric private chat/group ID as Worker secrets, never in site settings.
BOOKING_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Standard only: private file quotas (bytes and counts). Lite ignores these.
# FILES_USER_MAX_BYTES=52428800
# FILES_SITE_MAX_BYTES=536870912
# FILES_USER_MAX_COUNT=50
# FILES_SITE_MAX_COUNT=2000
